create_terrain TERR_TEMP { base_terrain TERR_PLAYER_TEMP land_percent 100 number_of_clumps 1 }
create_terrain SNOW_FOREST { base_terrain TERR_TEMP number_of_tiles NUM_TILES_PLAYER_FOREST number_of_clumps CLUMPS_PLAYER_FOREST spacing_to_other_terrain_types 3 set_avoid_player_start_areas 13 }
create_terrain TERR_PLAYER { base_terrain TERR_TEMP land_percent 100 number_of_clumps 4056 beach_terrain ICYSHORE }
create_terrain TERR_PLAYER { base_terrain TERR_TEMP land_percent 100 number_of_clumps 4056 beach_terrain ICYSHORE }
