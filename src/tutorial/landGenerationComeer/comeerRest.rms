create_terrain SNOW_FOREST { base_terrain TERR_TEMP number_of_tiles NUM_TILES_PLAYER_FOREST number_of_clumps CLUMPS_PLAYER_FOREST spacing_to_other_terrain_types 3 set_avoid_player_start_areas 13 }
create_terrain TERR_PLAYER { base_terrain TERR_TEMP land_percent 100 number_of_clumps 4056 beach_terrain ICYSHORE }
create_terrain TERR_PLAYER { base_terrain TERR_TEMP land_percent 100 number_of_clumps 4056 beach_terrain ICYSHORE }
create_terrain TERR_PLAYER { base_terrain TERR_TEMP land_percent 100 number_of_clumps 4056 beach_terrain ICYSHORE }



/* masking */
create_terrain TERR_NEUTRAL_MASK { base_terrain TERR_NEUTRAL land_percent 31 number_of_clumps 4056 terrain_mask 1 }
create_terrain TERR_MASK_PLAYER { base_terrain TERR_PLAYER land_percent 2 number_of_clumps 6 terrain_mask 1 }



/* neutral forests */
create_terrain SNOW_FOREST { base_terrain TERR_NEUTRAL number_of_tiles 470 number_of_clumps 30 spacing_to_other_terrain_types 2 set_scale_by_groups }


