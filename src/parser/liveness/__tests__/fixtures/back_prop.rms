if WINTER_VERSION
    #const HARE ARCTIC_HARE
elseif SUMMER_VERSION
    #define HARE_MIX_SUMMER
endif


<OBJECTS_GENERATION>

if HARE_MIX_SUMMER
    create_object_group HARE {
        add_object HARE_A 50
        add_object HARE_B 50
    }
endif
