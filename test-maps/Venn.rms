/* Created by Captain Kniples the Fourth */
/* For The Garrison 2026 tournament */
/* Created 2026 August */
/* This is a 1v1 map only */



/* **************************** CONTROL CONSTANTS **************************** */

#define REGICIDE

#const RADIUS_PLAYER_LANDS 21
#const RADIUS_AUX_LANDS 33
#const ROTATION_PLAYER 0 /* rnd(-10000,10000) */

/* min / max distance between players in degrees */
#const DIST_BW_PLAYERS 180


/* Land attributes */
#const BASE_SIZE_AUX 5
#const BASE_SIZE_PLAYER 3
#const BASE_ELEVATION_AUX 9
#const BASE_ELEVATION_OUTSIDE 1
#const LAND_PERCENT_PLAYER 100
#const DIST_TC_FROM_CENTRE 1

#const MAX_DIST_CENTER_WALLS 29
#const MAX_DIST_BACK_WALLS 23


/* **************************** MATH CONSTANTS **************************** */
/* ifs only */
if MAPSIZE_MINI			/* */
elseif MAPSIZE_TINY		/* 2 */
elseif MAPSIZE_SMALL		/* 3 */
elseif MAPSIZE_MEDIUM		/* 4 */
elseif MAPSIZE_NORMAL		/* 6 */
elseif MAPSIZE_LARGE		/* 8 */
elseif MAPSIZE_HUGE		/* */
elseif MAPSIZE_GIANT		/* */
elseif MAPSIZE_MASSIVE		/* */
elseif MAPSIZE_ENORMOUS		/* */
elseif MAPSIZE_COLOSSAL		/* */
elseif MAPSIZE_INCREDIBLE	/* */
elseif MAPSIZE_MONSTROUS	
elseif MAPSIZE_LUDICROUS	
else
endif

/* default sizes */
if MAPSIZE_MINI			#const MAPSIZE 80 /* */
elseif MAPSIZE_TINY		#const MAPSIZE 120 /* 2 */
elseif MAPSIZE_SMALL		#const MAPSIZE 144 /* 3 */
elseif MAPSIZE_MEDIUM		#const MAPSIZE 168 /* 4 */
elseif MAPSIZE_NORMAL		#const MAPSIZE 200 /* 6 */
elseif MAPSIZE_LARGE		#const MAPSIZE 220 /* 8 */
elseif MAPSIZE_HUGE		#const MAPSIZE 240 /* */
elseif MAPSIZE_GIANT		#const MAPSIZE 252 /* */
elseif MAPSIZE_MASSIVE		#const MAPSIZE 276 /* */
elseif MAPSIZE_ENORMOUS		#const MAPSIZE 300 /* */
elseif MAPSIZE_COLOSSAL		#const MAPSIZE 320 /* */
elseif MAPSIZE_INCREDIBLE	#const MAPSIZE 360 /* */
elseif MAPSIZE_MONSTROUS	#const MAPSIZE 400 
elseif MAPSIZE_LUDICROUS	#const MAPSIZE 480 
else				#const MAPSIZE 260 
endif

/* for area scaling */
#const MAPSIZE_HALF (MAPSIZE / 2)
#const MAPAREA (MAPSIZE * MAPSIZE)


/* Player 1 land */
#const DEGREES_P1 ROTATION_PLAYER
#const R_P1 (DEGREES_P1 % 360 + 360 % 360 * -1 + 180)
#const S_P1 (R_P1 * 2 + 1 % 2)
#const P_P1 (180 * S_P1 - R_P1 * R_P1)
#const D_P1 (40500 - P_P1)
#const SIN_P1 (S_P1 * 4 * P_P1 / D_P1)
#const CR_P1 (270 - R_P1 % 360 * -1 + 180)
#const CS_P1 (CR_P1 * 2 + 1 % 2)
#const CP_P1 (180 * CS_P1 - CR_P1 * CR_P1)
#const CD_P1 (40500 - CP_P1)
#const COS_P1 (CS_P1 * 4 * CP_P1 / CD_P1)

#const X_P1 (RADIUS_PLAYER_LANDS * COS_P1 + 50)
#const Y_P1 (RADIUS_PLAYER_LANDS * SIN_P1 + 50)

#const X_P1_TC (RADIUS_PLAYER_LANDS + DIST_TC_FROM_CENTRE * COS_P1 + 50)
#const Y_P1_TC (RADIUS_PLAYER_LANDS + DIST_TC_FROM_CENTRE * SIN_P1 + 50)

/* Player 2 land */
#const DEGREES_P2 (DIST_BW_PLAYERS + ROTATION_PLAYER)
/* #const DEGREES_P2 DEG_P2_UPPER_BOUND */
#const R_P2 (DEGREES_P2 % 360 + 360 % 360 * -1 + 180)
#const S_P2 (R_P2 * 2 + 1 % 2)
#const P_P2 (180 * S_P2 - R_P2 * R_P2)
#const D_P2 (40500 - P_P2)
#const SIN_P2 (S_P2 * 4 * P_P2 / D_P2)
#const CR_P2 (270 - R_P2 % 360 * -1 + 180)
#const CS_P2 (CR_P2 * 2 + 1 % 2)
#const CP_P2 (180 * CS_P2 - CR_P2 * CR_P2)
#const CD_P2 (40500 - CP_P2)
#const COS_P2 (CS_P2 * 4 * CP_P2 / CD_P2)

#const X_P2 (RADIUS_PLAYER_LANDS * COS_P2 + 50)
#const Y_P2 (RADIUS_PLAYER_LANDS * SIN_P2 + 50)

#const X_P2_TC (RADIUS_PLAYER_LANDS + DIST_TC_FROM_CENTRE * COS_P2 + 50)
#const Y_P2_TC (RADIUS_PLAYER_LANDS + DIST_TC_FROM_CENTRE * SIN_P2 + 50)

/* Neutral Aux lands */
#const DEGREES_A1 (DEGREES_P1 + 90)
#const R_A1 (DEGREES_A1 % 360 + 360 % 360 * -1 + 180)
#const S_A1 (R_A1 * 2 + 1 % 2)
#const P_A1 (180 * S_A1 - R_A1 * R_A1)
#const D_A1 (40500 - P_A1)
#const SIN_A1 (S_A1 * 4 * P_A1 / D_A1)
#const CR_A1 (270 - R_A1 % 360 * -1 + 180)
#const CS_A1 (CR_A1 * 2 + 1 % 2)
#const CP_A1 (180 * CS_A1 - CR_A1 * CR_A1)
#const CD_A1 (40500 - CP_A1)
#const COS_A1 (CS_A1 * 4 * CP_A1 / CD_A1)
/* Open field */
#const X_A1 (RADIUS_AUX_LANDS * COS_A1 + 50)
#const Y_A1 (RADIUS_AUX_LANDS * SIN_A1 + 50)
/* Dense forest */
#const X_A1_DENSE (49 * COS_A1 + 50)
#const Y_A1_DENSE (49 * SIN_A1 + 50)

#const DEGREES_A2 (DEGREES_A1 + 180)
#const R_A2 (DEGREES_A2 % 360 + 360 % 360 * -1 + 180)
#const S_A2 (R_A2 * 2 + 1 % 2)
#const P_A2 (180 * S_A2 - R_A2 * R_A2)
#const D_A2 (40500 - P_A2)
#const SIN_A2 (S_A2 * 4 * P_A2 / D_A2)
#const CR_A2 (270 - R_A2 % 360 * -1 + 180)
#const CS_A2 (CR_A2 * 2 + 1 % 2)
#const CP_A2 (180 * CS_A2 - CR_A2 * CR_A2)
#const CD_A2 (40500 - CP_A2)
#const COS_A2 (CS_A2 * 4 * CP_A2 / CD_A2)
/* Open field */
#const X_A2 (RADIUS_AUX_LANDS * COS_A2 + 50)
#const Y_A2 (RADIUS_AUX_LANDS * SIN_A2 + 50)
/* Dense forest */
#const X_A2_DENSE (49 * COS_A2 + 50)
#const Y_A2_DENSE (49 * SIN_A2 + 50)



/* **************************** OBJECT CONSTANTS **************************** */
#const ONGRID_PLACEHOLDER 1613

#const HERDABLE_A 1245 /* Pig */
#const HERDABLE_B 594 /* Sheep */
#const HUNTABLE 65
#const LURABLE  48
#const THEMED_TREE1 1347 /* cyprus */
#const THEMED_TREE2 1348 /* italian pine */
#const THEMED_TREE3 1349 /* olive */
#const PLACEHOLDER_WALL 278
#const PLACEHOLDER 1543
#const TREE_REED 1350


#const LAZY_MALE 1285 /* FE Flag */
effect_amount SET_ATTRIBUTE LAZY_MALE ATTR_DEAD_ID 83
effect_amount SET_ATTRIBUTE LAZY_MALE ATTR_HITPOINTS 0

#const LAZY_FEMALE 851 /* ES Flag */
effect_amount SET_ATTRIBUTE LAZY_FEMALE ATTR_DEAD_ID 293
effect_amount SET_ATTRIBUTE LAZY_FEMALE ATTR_HITPOINTS 0


      #const ESCALATION_REVEALER 1874
      #const PH_NEUTRAL_OFF 346 /* Off-Grid Object - only used for gaia objects */
      #const PH_PLAYER_OFF 647 /* Off-Grid Object - only used for player objects */

/* **************************** TERRAIN CONSTANTS **************************** */
#const TERR_FOREST_REEDS 92
#const TERRAIN_FOREST_SPARSE DLC_DRYGRASS
#const LAYER_FOREST_SPARSE TERR_FOREST_REEDS
#const TERRAIN_DENSE_FOREST JUNGLE
#const LAYER_AUX DIRT2
#const TERRAIN_AUX_TEMP DLC_BOGLAND
#const TERRAIN_AUX_FOREST_CUT 71 /* leafy underbrush */
#const TERRAIN_AUX_NOBUILD_EXT DLC_ROCK
#const TERRAIN_ROCKS 70 /* gravel */
#const LAYER_BASE GRASS
#const LAYER_CENTER DIRT
#const TERRAIN_TC_LOC 41
#const LAYER_PLAYER GRASS2
/* #const TERRAIN_PLAYER2 DIRT */
#const TERRAIN_GAIA DLC_ROCK
#const TERRAIN_TEMP DIRT3
#const TERRAIN_PL_WALLS 70 /* Gravel */
#const TERRAIN_BASE DLC_DIRT4
#const TERRAIN_PLAYER DIRT3
#const TERRAIN_CENTER DLC_CRACKED

/* **************************** EFFECTS **************************** */

/* make the herdable under the TC die and only have 70 food */
/* note that you should NOT place this herdable type for gaia anywhere else */
effect_amount GAIA_ADD_ATTRIBUTE HERDABLE_A ATTR_STORAGE_VALUE -30	
effect_amount GAIA_SET_ATTRIBUTE HERDABLE_A ATTR_HITPOINTS 0

effect_amount MOD_RESOURCE AMOUNT_STARTING_WOOD ATTR_ADD -30
effect_amount MOD_RESOURCE AMOUNT_STARTING_FOOD ATTR_ADD -90

/* #define DEBUGGING */





<PLAYER_SETUP>
direct_placement
behavior_version 2

<LAND_GENERATION>
base_terrain LAYER_BASE


create_land
{
terrain_type                    LAYER_PLAYER 
base_size                       9
land_percent                    100
land_position                   X_P1 Y_P1
zone 1
land_id 12
}


create_land
{
terrain_type                    LAYER_PLAYER 
base_size                       9
land_percent                    100
land_position                   X_P2 Y_P2
zone 2
land_id 12
}

create_land
{
terrain_type                    TERRAIN_TC_LOC
base_size                       9
land_percent                    0
land_position                   X_P1_TC Y_P1_TC
assign_to_player                2
set_circular_base
zone 3
}


create_land
{
terrain_type                    TERRAIN_TC_LOC 
base_size                       9
land_percent                    0
land_position                   X_P2_TC Y_P2_TC
assign_to_player                1
set_circular_base
zone 3
}


#const BORDER_AUX_WIDTH 15
#const BORDER_AUX_LENGTH 31
