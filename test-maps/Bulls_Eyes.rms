<CONNECTION_GENERATION>
#const ROCK_WALL_WIDTH 8
create_connect_land_zones 1 11 {
 replace_terrain TERRAIN_AUX_TEMP TERRAIN_ROCKS

 terrain_cost TERRAIN_PLAYER 1
 terrain_cost TERRAIN_BASE 3
 terrain_cost TERRAIN_AUX 4
 terrain_cost TERRAIN_AUX_TEMP 12

 terrain_size TERRAIN_AUX_TEMP ROCK_WALL_WIDTH 0
}
create_connect_land_zones 2 22 {
 replace_terrain TERRAIN_AUX_TEMP TERRAIN_ROCKS

 terrain_cost TERRAIN_PLAYER 1
 terrain_cost TERRAIN_BASE 3
 terrain_cost TERRAIN_AUX 4
 terrain_cost TERRAIN_AUX_TEMP 12

 terrain_size TERRAIN_AUX_TEMP ROCK_WALL_WIDTH 0
}
accumulate_connections
create_connect_land_zones 2 22 {
 replace_terrain TERRAIN_AUX_TEMP TERRAIN_AUX_NOBUILD_EXT
 
 terrain_cost TERRAIN_PLAYER 22
 terrain_cost TERRAIN_BASE 22
 terrain_cost TERRAIN_AUX 22
 terrain_cost TERRAIN_AUX_TEMP 1 

 terrain_size TERRAIN_AUX_TEMP 1026 0
}

