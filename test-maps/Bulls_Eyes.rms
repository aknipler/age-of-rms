#const X_P1_A2 (RADIUS_AUX_LANDS * COS_P1_A2 + X_P1)
#const Y_P1_A2 (RADIUS_AUX_LANDS * SIN_P1_A2 + Y_P1)

#const DEGREES_P1_A3 (DEGREES_P1 + 315 + ROTATION_AUX + VAR_A3)
#const R_P1_A3 (DEGREES_P1_A3 % 360 + 360 % 360 * -1 + 180)
