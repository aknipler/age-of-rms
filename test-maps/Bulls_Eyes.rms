#const CP_P1_A1 (180 * CS_P1_A1 - CR_P1_A1 * CR_P1_A1)
#const CD_P1_A1 (40500 - CP_P1_A1)
#const COS_P1_A1 (CS_P1_A1 * 4 * CP_P1_A1 / CD_P1_A1)
#const X_P1_A1 (RADIUS_AUX_LANDS * COS_P1_A1 + X_P1)
#const Y_P1_A1 (RADIUS_AUX_LANDS * SIN_P1_A1 + Y_P1)

#const DEGREES_P1_A2 (DEGREES_P1 + 45 + ROTATION_AUX + VAR_A2)
#const R_P1_A2 (DEGREES_P1_A2 % 360 + 360 % 360 * -1 + 180)
