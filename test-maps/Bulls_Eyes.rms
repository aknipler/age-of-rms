/* **************************** CONTROL CONSTANTS **************************** */

#const RADIUS_PLAYER_LANDS 26
#const RADIUS_AUX_LANDS 14
#const ROTATION_PLAYER rnd(-10000,10000)
#const ROTATION_AUX rnd(-180,180)
#const VARIANCE_AUX_LAND_DEGREES 2
#const VAR_A1 rnd(-VARIANCE_AUX_LAND_DEGREES,VARIANCE_AUX_LAND_DEGREES)
#const VAR_A2 rnd(-VARIANCE_AUX_LAND_DEGREES,VARIANCE_AUX_LAND_DEGREES)
#const VAR_A3 rnd(-VARIANCE_AUX_LAND_DEGREES,VARIANCE_AUX_LAND_DEGREES)

/* min / max distance between players in degrees */
#const DIST_BW_PLAYERS rnd(80,280)


/* Land attributes */
#const BASE_SIZE_AUX 7
#const BASE_SIZE_PLAYER 12
#const BASE_ELEVATION_AUX 9
#const BASE_ELEVATION_PLAYER 9


/* **************************** MATH CONSTANTS **************************** */
