/*
================================================================================
RMSTEST_85a - SET_ATTRIBUTE HOUSE ATTR_STANDING_GRAPHIC 3124 (mill)
Feeds: docs/preview-de-textures-design.md Sec.14.3, whether the preview's reading
of ATTR_STANDING_GRAPHIC holds for player objects.
Generate at Tiny, 2 players, seed 1000. Look in the editor and in a started game.
Prediction (the preview's reading): each player's 6 houses draw as the Dark Age
mill (graphic 3124). Otherwise they draw as houses. 85b is the control.
*/

<PLAYER_SETUP>
  random_placement

<LAND_GENERATION>
  base_terrain GRASS
  create_player_lands
  {
    terrain_type GRASS
    land_percent 60
    base_size 12
  }

<OBJECTS_GENERATION>
effect_amount SET_ATTRIBUTE HOUSE ATTR_STANDING_GRAPHIC 3124

create_object TOWN_CENTER
{
  set_place_for_every_player
  max_distance_to_players 0
}

create_object HOUSE
{
  set_place_for_every_player
  number_of_objects 6
  min_distance_to_players 8
  max_distance_to_players 14
}

