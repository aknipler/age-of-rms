<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_player_lands { terrain_type DIRT base_size 5 number_of_tiles 0 }
<OBJECTS_GENERATION>
create_object TOWN_CENTER { set_place_for_every_player max_distance_to_players 0 }
create_object STONE { set_place_for_every_player set_gaia_object_only min_distance_to_players 8 max_distance_to_players 10 number_of_objects 3 }
create_object GOLD { set_place_for_every_player set_gaia_object_only min_distance_to_players 8 max_distance_to_players 10 number_of_objects 3 set_circular_placement }
create_object FORAGE { set_place_for_every_player set_gaia_object_only find_closest min_distance_to_players 6 }
create_object DEER { set_place_for_every_player set_gaia_object_only find_closest min_distance_to_players 12 enable_tile_shuffling }
create_object BOAR { set_place_for_every_player set_gaia_object_only find_closest_to_map_edge min_distance_to_players 10 max_distance_to_players 14 }
create_object SHEEP { set_place_for_every_player number_of_objects 4 min_distance_to_players 4 max_distance_to_players 6 }
