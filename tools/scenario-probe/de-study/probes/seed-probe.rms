<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_land { /* orientation marker: dirt, between land 1 and land 2, at the map edge; no random draws */
  terrain_type DIRT land_position 21 3 base_size 1 number_of_tiles 0
}
create_land { /* land 1 */
  if L1_W terrain_type WATER elseif L1_D terrain_type DESERT
  elseif L1_S terrain_type SNOW else terrain_type FOREST endif
  land_position 12 12 base_size 3 number_of_tiles 0
}
