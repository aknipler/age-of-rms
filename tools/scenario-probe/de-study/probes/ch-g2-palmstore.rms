#const T_PALM 13
#const T_DIRT2 11
<PLAYER_SETUP>
random_placement
effect_amount SET_ATTRIBUTE PALMTREE ATTR_STORAGE_VALUE 200
<LAND_GENERATION>
base_terrain GRASS
create_land { terrain_type T_PALM land_position 20 25 number_of_tiles 0 base_size 9 }
create_land { terrain_type JUNGLE land_position 50 25 number_of_tiles 0 base_size 9 }
create_land { terrain_type DESERT land_position 80 25 number_of_tiles 0 base_size 9 }
create_land { terrain_type T_DIRT2 land_position 20 70 number_of_tiles 0 base_size 9 }
create_land { terrain_type DLC_RAINFOREST land_position 50 70 number_of_tiles 0 base_size 9 }
<TERRAIN_GENERATION>
create_terrain T_PALM { base_terrain T_DIRT2 land_percent 100 number_of_clumps 1 }
create_terrain T_PALM { base_terrain DESERT land_percent 100 number_of_clumps 1 terrain_mask 1 }
