<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
<CLIFF_GENERATION>
min_number_of_cliffs 8
max_number_of_cliffs 10
<TERRAIN_GENERATION>
create_terrain FOREST { base_terrain GRASS land_percent 10 number_of_clumps 10 }
<OBJECTS_GENERATION>
create_object OAKTREE { number_of_objects 10 }
create_object GOLD { number_of_objects 25 avoid_forest_zone 3 }
create_object STONE { number_of_objects 25 avoid_forest_zone }
create_object FORAGE { number_of_objects 30 place_on_forest_zone }
create_object DEER { number_of_objects 25 avoid_cliff_zone 3 }
create_object BOAR { number_of_objects 25 avoid_cliff_zone }
create_object SHEEP { number_of_groups 8 number_of_objects 3 avoid_forest_zone 2 }
