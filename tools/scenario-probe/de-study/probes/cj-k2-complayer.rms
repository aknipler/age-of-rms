#const T_C62 62
#const T_60 60
#const MAKE_DIRT3_TERRAIN 1640
<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_land { terrain_type T_60 land_position 50 50 number_of_tiles 0 base_size 12 }
<TERRAIN_GENERATION>
create_terrain T_C62 { base_terrain T_60 land_percent 100 number_of_clumps 1 terrain_mask 1 }
<OBJECTS_GENERATION>
create_object MAKE_DIRT3_TERRAIN { set_gaia_object_only number_of_objects 200000 terrain_to_place_on T_60 }
create_object STONE { set_gaia_object_only number_of_groups 10 terrain_to_place_on GRASS }
