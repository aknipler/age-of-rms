<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
start_random
percent_chance 50 create_land { terrain_type DESERT land_position rnd(10,90) rnd(10,90) number_of_tiles 0 base_size 2 }
percent_chance 50 create_land { terrain_type SNOW land_position rnd(10,90) rnd(10,90) number_of_tiles 0 base_size 2 }
end_random
create_land { terrain_type DIRT land_position rnd(10,90) rnd(10,90) number_of_tiles 0 base_size 2 }
