<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
<TERRAIN_GENERATION>
create_terrain DIRT { base_terrain GRASS number_of_tiles 1200 number_of_clumps 40 }
<OBJECTS_GENERATION>
