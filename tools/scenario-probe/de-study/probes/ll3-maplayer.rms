<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain DESERT
base_layer DIRT3
create_land { terrain_type DIRT land_position 30 50 number_of_tiles 500 base_size 3 zone 1 base_layer SNOW }
