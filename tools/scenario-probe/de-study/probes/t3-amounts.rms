<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain DESERT
create_land { terrain_type SNOW base_size 1 number_of_tiles 0 land_position 1 1 }
<TERRAIN_GENERATION>
create_terrain DIRT { base_terrain DESERT land_percent 10 number_of_clumps 4 }
create_terrain SNOW { base_terrain DESERT number_of_tiles -5 }
create_terrain LEAVES { base_terrain DESERT number_of_tiles 200 number_of_clumps 3 set_scale_by_groups }
create_terrain GRASS { base_terrain DESERT number_of_tiles 300 set_scale_by_size }
