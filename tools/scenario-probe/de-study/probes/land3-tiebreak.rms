/* Growth tie-break probe. Four one-tile lands (base_size 0) at fixed spots, wanting 2, 3, 4 and 5 tiles.
   Which neighbours get painted, and in what order, shows the frontier tie-break rule. */
<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_land { terrain_type DESERT base_size 0 number_of_tiles 2 land_position 20 25 }
create_land { terrain_type SNOW base_size 0 number_of_tiles 3 land_position 45 25 }
create_land { terrain_type FOREST base_size 0 number_of_tiles 4 land_position 70 25 }
create_land { terrain_type DIRT base_size 0 number_of_tiles 5 land_position 20 60 }
