create_object FERN { set_gaia_object_only number_of_groups 10 terrain_to_place_on T_D  }
create_object UNDERBRUSH { set_gaia_object_only number_of_groups 10 terrain_to_place_on T_D set_facet 2 }
create_object SHRUB_DRY { set_gaia_object_only number_of_groups 10 terrain_to_place_on T_E  }
create_object GRAVES { set_gaia_object_only number_of_groups 10 terrain_to_place_on T_E  }
create_object UNDERBRUSH_RAIN { set_gaia_object_only number_of_groups 10 terrain_to_place_on T_F set_facet 1 }
create_object MAPLE_LEAVES { set_gaia_object_only number_of_groups 10 terrain_to_place_on T_F set_loose_grouping number_of_objects 3 group_placement_radius 3 }
