create_land { terrain_type T_E land_position 50 70 number_of_tiles 0 base_size 9 }
create_land { terrain_type T_F land_position 80 70 number_of_tiles 0 base_size 9 }
<OBJECTS_GENERATION>
create_object MAPLE_LEAVES { set_gaia_object_only number_of_groups 10 terrain_to_place_on T_A  }
create_object FERN { set_gaia_object_only number_of_groups 10 terrain_to_place_on T_A set_facet 1 }
create_object MAPLE_LEAVES { set_gaia_object_only number_of_groups 10 terrain_to_place_on T_B set_facet 0 }
