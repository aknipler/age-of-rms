<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain WATER
create_player_lands { terrain_type DIRT number_of_tiles 600 base_size 6 other_zone_avoidance_distance 8 }
<OBJECTS_GENERATION>
create_object GOLD { set_place_for_every_player set_gaia_object_only min_distance_to_players 4 max_distance_to_players 40 number_of_objects 6 }
create_object STONE { set_place_for_every_player min_distance_to_players 4 max_distance_to_players 40 }
create_object FISH { number_of_objects 20 }
create_object SHORE_FISH { number_of_objects 15 terrain_to_place_on WATER }
create_object SALMON { number_of_objects 10 ignore_terrain_restrictions }
