<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_player_lands { terrain_type DIRT land_percent 30 base_size 10 border_fuzziness 5 clumping_factor 15 other_zone_avoidance_distance 7 }
create_land { terrain_type WATER land_percent 4 land_position 50 50 base_size 6 }
<ELEVATION_GENERATION>
create_elevation 3 { base_terrain GRASS number_of_tiles 1200 number_of_clumps 8 set_scale_by_groups }
<TERRAIN_GENERATION>
create_terrain FOREST { base_terrain GRASS land_percent 12 number_of_clumps 14 spacing_to_other_terrain_types 2 set_avoid_player_start_areas 13 }
<CONNECTION_GENERATION>
create_connect_teams_lands { replace_terrain GRASS DIRT2 replace_terrain FOREST LEAVES terrain_size FOREST 2 1 terrain_cost FOREST 5 }
create_connect_all_players_land { replace_terrain FOREST GRASS3 replace_terrain WATER SHALLOW terrain_cost WATER 4 terrain_size WATER 1 1 terrain_cost FOREST 7 }
<OBJECTS_GENERATION>
create_object TOWN_CENTER { set_place_for_every_player max_distance_to_players 0 }
create_object VILLAGER { set_place_for_every_player min_distance_to_players 6 max_distance_to_players 6 }
create_object SCOUT { set_place_for_every_player min_distance_to_players 7 max_distance_to_players 9 }
create_object GOLD { set_place_for_every_player set_gaia_object_only number_of_objects 7 group_placement_radius 3 set_tight_grouping min_distance_to_players 12 max_distance_to_players 16 avoid_forest_zone 2 }
create_object STONE { set_place_for_every_player set_gaia_object_only number_of_objects 5 group_placement_radius 2 set_tight_grouping min_distance_to_players 14 max_distance_to_players 18 temp_min_distance_group_placement 10 }
create_object FORAGE { set_place_for_every_player set_gaia_object_only number_of_objects 6 group_placement_radius 3 set_tight_grouping min_distance_to_players 8 max_distance_to_players 10 }
create_object SHEEP { set_place_for_every_player number_of_objects 4 min_distance_to_players 7 max_distance_to_players 8 }
create_object BOAR { set_place_for_every_player set_gaia_object_only number_of_objects 2 set_loose_grouping min_distance_to_players 16 max_distance_to_players 22 }
create_object DEER { set_place_for_every_player set_gaia_object_only number_of_objects 4 group_placement_radius 3 min_distance_to_players 20 max_distance_to_players 26 }
create_object GOLD { number_of_groups 3 number_of_objects 4 set_tight_grouping set_scaling_to_map_size min_distance_to_players 30 avoid_forest_zone 3 max_distance_to_other_zones 4 min_distance_group_placement 9 }
create_object RELIC { number_of_objects 5 min_distance_to_players 25 temp_min_distance_group_placement 20 }
create_object OAKTREE { number_of_objects 3 set_place_for_every_player set_gaia_object_only min_distance_to_players 5 max_distance_to_players 9 }
create_object FISH { number_of_objects 6 avoid_cliff_zone 2 }
