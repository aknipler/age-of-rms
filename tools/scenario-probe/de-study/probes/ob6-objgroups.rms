add_object GOLD 10
add_object STONE 90
}
create_object_group EVEN {
add_object DEER 50
add_object SHEEP 50
}
create_object_group THREE {
add_object FORAGE 30
add_object BOAR 30
add_object TURKEY 40
}
create_object LOW_FIRST { number_of_objects 40 }
create_object EVEN { number_of_objects 40 }
create_object THREE { number_of_objects 40 }
