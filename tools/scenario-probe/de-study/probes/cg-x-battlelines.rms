create_terrain	TERR_FOREST
{
	base_terrain	TERR_PLAYER
	number_of_tiles	(MAPAREA * 0.02)
	number_of_clumps	(MAPAREA * 0.003)
	spacing_to_specific_terrain		TERR_CENTER	(MAPSIZE * 0.06 + 3)
	if AT_LEAST_3_PLAYERS
		set_avoid_player_start_areas	12
	endif
}

/* scatter forests on corner terrain */
	create_terrain	TERR_TEMP_1
	{
		base_terrain	TERR_CORNER
		number_of_tiles	(MAPAREA * 0.025)
		number_of_clumps	(MAPAREA * 0.001)
		spacing_to_specific_terrain		TERR_BLACK	(MAPSIZE * 0.05 + 2)
		spacing_to_other_terrain_types	2
	}
	if RELICS_IN_FOREST
		create_terrain	TERR_TEMP_2
		{
			base_terrain	TERR_CORNER
			number_of_tiles	(MAPAREA * 0.055)
			number_of_clumps	(MAPAREA * 0.001)
			spacing_to_specific_terrain		TERR_BLACK	(MAPSIZE * 0.05 + 1)
			spacing_to_specific_terrain		TERR_TEMP_1	3
			spacing_to_other_terrain_types	2
			clumping_factor			25
		}
		create_terrain	TERR_FOREST_B
		{
			base_terrain	TERR_TEMP_2
			number_of_tiles	(MAPAREA * 0.015)
			number_of_clumps	(MAPAREA * 0.005)
			spacing_to_other_terrain_types	1
		}
		create_terrain	TERR_FOREST
		{
			base_terrain	TERR_TEMP_1
			number_of_tiles	(MAPAREA * 0.036)
			number_of_clumps	(MAPAREA * 0.0015)
		}
		create_terrain	TERR_FOREST
		{
			base_terrain	TERR_TEMP_2
			number_of_tiles	(MAPAREA * 0.045)
			number_of_clumps	(MAPAREA * 0.015)
		}
		create_terrain	TERR_FOREST
		{
			base_terrain	TERR_TEMP_2
			number_of_tiles	(MAPAREA * 0.005)
			number_of_clumps	(MAPAREA * 0.005)
		}
	else
		create_terrain	TERR_FOREST_B
		{
			base_terrain	TERR_CORNER
			number_of_tiles	(MAPAREA * 0.055)
			number_of_clumps	(MAPAREA * 0.001)
			spacing_to_specific_terrain		TERR_BLACK	(MAPSIZE * 0.05 + 1)
			spacing_to_specific_terrain		TERR_TEMP_1	3
			spacing_to_other_terrain_types	2
		}
		create_terrain	TERR_FOREST_B
		{
			base_terrain	TERR_TEMP_1
			number_of_tiles	(MAPAREA * 0.036)
			number_of_clumps	(MAPAREA * 0.0015)
		}
	endif
/* final terrain replacement */
	create_terrain	TERR_FILL_FINAL
	{
		base_terrain	TERR_BASE
		number_of_tiles		(MAPAREA * 0.3)
		number_of_clumps		(MAPAREA * 0.06)
	}
