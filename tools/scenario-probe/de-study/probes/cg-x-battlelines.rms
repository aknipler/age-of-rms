<ELEVATION_GENERATION>
create_elevation	3
{
	base_terrain		TERR_CORNER
	number_of_tiles	(MAPAREA * 0.04)
	number_of_clumps	(MAPAREA * 0.001)
	enable_balanced_elevation
}
<TERRAIN_GENERATION>

create_terrain	TERR_FOREST
{
	base_terrain	TERR_BASE
	number_of_tiles	(MAPAREA * 0.3)
	number_of_clumps	(MAPAREA * 0.007)
	set_avoid_player_start_areas	(MAPSIZE * 0.22)
}

