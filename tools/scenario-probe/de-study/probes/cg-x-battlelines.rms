if WEAK_RELICS
	effect_amount MUL_RESOURCE AMOUNT_RELIC_GENERATION_GOLD ATTR_DISABLE 0.66666
endif
<LAND_GENERATION>

#const L_ID_CENTER	2
#const L_ID_PLAYER_LAND	1
#const L_ID_CORNER	3
#const CORNER_ROUND	0.14
#const CORNER_SQUARE	0.14
#const CORNER_AREA	(CORNER_ROUND * CORNER_ROUND) /* unused? */
#const CORNER_MID_L	25
#const CORNER_MID_H	74
#const CORNER_OUT_L	8
#const CORNER_OUT_H	91

base_terrain TERR_BASE

create_land
{
	terrain_type			TERR_CENTER
	land_position			50 50
	base_size			1
	number_of_tiles		1
	land_conformity		99
	land_id			L_ID_CENTER
	base_elevation		2
}
create_player_lands
{
	terrain_type			TERR_PLAYER
	base_size			7
	set_circular_base
	circle_radius			15 0
	number_of_tiles		(MAPAREA * 0.09 * NUM_PI)
	land_conformity		99
	other_zone_avoidance_distance	3
	land_id			L_ID_PLAYER_LAND
}

if AT_LEAST_3_PLAYERS
else
	create_player_lands
	{
		terrain_type			TERR_BASE
		base_size			1
		number_of_tiles		0
		circle_radius			13 0
	}
endif

