<PLAYER_SETUP>
random_placement

effect_amount MOD_RESOURCE AMOUNT_WORKSHOP_TRICKLE_FOOD ATTR_SET 0.001
effect_amount MOD_RESOURCE AMOUNT_WORKSHOP_TRICKLE_WOOD ATTR_SET 0.001
effect_amount MOD_RESOURCE AMOUNT_WORKSHOP_TRICKLE_STONE ATTR_SET 0.001
effect_amount MOD_RESOURCE AMOUNT_WORKSHOP_TRICKLE_GOLD ATTR_SET 0.4

