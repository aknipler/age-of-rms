	if AT_LEAST_3_PLAYERS
		spacing_to_specific_terrain		TERR_CORNER	4
	else
		spacing_to_specific_terrain		TERR_CORNER	5
	endif
	}

	create_terrain	TERR_FILL_A
	{
		base_terrain	TERR_BASE
		number_of_tiles	(MAPAREA * 0.15)
		number_of_clumps	(MAPAREA * 0.001)
