/* parameter renames */
	#const restricted_terrain_distance		max_distance_to_other_zones

#const NUM_PI		3.14159

#const TERR_BASE	83	/* grass, jungle (rainforest) */
#const TERR_PLAYER	GRASS
#const TERR_CORNER	GRASS2
#const TERR_CENTER	GRASS3
#const TERR_FILL_A	DIRT2
#const TERR_TEMP_1	DIRT
#const TERR_BLACK	129	/* Black, walkable */
#const TERR_FOREST	FOREST
#const TERR_TEMP_2	8	/* Farm, dead */
#const TERR_P_POINT	7	/* Farm */
#const TERR_FOREST_B	20

start_random	/* replace land terrains with the final terrain choice, may reuse a terrain */
percent_chance	30
#const TERR_FILL_FINAL	83	/* grass, jungle (rainforest) */
percent_chance	30
#const TERR_FILL_FINAL	GRASS
percent_chance	30
#const TERR_FILL_FINAL	GRASS3
percent_chance	10
#const TERR_FILL_FINAL	DLC_DRYGRASS
end_random

