<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain FOREST
create_player_lands { terrain_type DIRT number_of_tiles 0 base_size 9 }
create_land { terrain_type GRASS land_percent 30 land_position 50 50 base_size 6 }
<OBJECTS_GENERATION>
create_object TOWN_CENTER { set_place_for_every_player max_distance_to_players 0 actor_area 7 actor_area_radius 6 }
create_object VILLAGER { set_place_for_every_player actor_area_to_place_in 7 avoid_forest_zone 2 }
create_object SCOUT { set_place_for_every_player actor_area_to_place_in 7 avoid_forest_zone 2 }
create_object DEER { number_of_objects 3 number_of_groups 6 set_loose_grouping set_gaia_object_only min_distance_to_players 15 }
create_object GOLD { number_of_objects 3 number_of_groups 4 set_tight_grouping set_gaia_object_only min_distance_to_players 15 temp_min_distance_group_placement 10 }
create_object FORAGE { number_of_objects 1 number_of_groups 20 set_gaia_object_only min_distance_to_players 12 }
