/* ************************************ */
<LAND_GENERATION>

/* Random Terrain Types */

start_random
  percent_chance 100
     #define ASIAN_MAP
  percent_chance 0
     #define WINTER_MAP
  percent_chance 0
     #define TROPICAL_MAP

end_random


if WINTER_MAP

elseif TROPICAL_MAP 

