elseif SMALL_MAP	override_map_size 178
elseif MEDIUM_MAP	override_map_size 204
elseif LARGE_MAP	override_map_size 240
elseif HUGE_MAP	override_map_size 260
elseif GIGANTIC_MAP	override_map_size 300
