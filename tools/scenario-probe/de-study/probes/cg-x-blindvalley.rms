base_terrain BT

if 2_PLAYER_GAME 

/* player 1 positions */
	start_random
		percent_chance 33 #define ANGLE1
		percent_chance 34 #define ANGLE2
		percent_chance 33  #define ANGLE3
	end_random
	
/* player 2 positions */
	start_random
		percent_chance 50 #define ANGLE2A
		percent_chance 50 #define ANGLE2B
	end_random
	

	create_land { if ANGLE1 terrain_type PL2 number_of_tiles 0  base_size 24 circle_radius 30 0 left_border 5 right_border 4 top_border 6  bottom_border 5 other_zone_avoidance_distance 0 base_elevation 1 land_conformity 99 set_circular_base  assign_to_player 1 zone 1 land_id 1 elseif ANGLE2 terrain_type PL1 number_of_tiles 0  base_size 24 circle_radius 30 0 left_border 5 right_border 4 top_border 6  bottom_border 5 other_zone_avoidance_distance 0 base_elevation 1 land_conformity 99 set_circular_base assign_to_player 1 zone 95 elseif ANGLE3 terrain_type PL2 number_of_tiles 0  base_size 24 circle_radius 30 0 left_border 5 right_border 4 top_border 6  bottom_border 5 other_zone_avoidance_distance 0 base_elevation 1 land_conformity 99 set_circular_base  assign_to_player 1 zone 1 land_id 1 endif }
	create_land { if ANGLE2 terrain_type PL2 number_of_tiles 0  base_size 24 circle_radius 30 0 left_border 5 right_border 4 top_border 6  bottom_border 5 other_zone_avoidance_distance 0 base_elevation 1 land_conformity 99 set_circular_base assign_to_player 1 zone 1 land_id 1 elseif ANGLE3 terrain_type PL1 number_of_tiles 0  base_size 24 circle_radius 30 0 left_border 5 right_border 4 top_border 6  bottom_border 5 other_zone_avoidance_distance 0 base_elevation 1 land_conformity 99 set_circular_base assign_to_player 1 zone 95 elseif ANGLE1 terrain_type PL2 number_of_tiles 0  base_size 24 circle_radius 30 0 left_border 5 right_border 4 top_border 6  bottom_border 5 other_zone_avoidance_distance 0 base_elevation 1 land_conformity 99 set_circular_base assign_to_player 1 zone 1 land_id 1  endif  }
	create_land { if ANGLE3 terrain_type PL2 number_of_tiles 0  base_size 24 circle_radius 30 0 left_border 5 right_border 4 top_border 6  bottom_border 5 other_zone_avoidance_distance 0 base_elevation 1 land_conformity 99 set_circular_base assign_to_player 1 zone 1 land_id 1 elseif ANGLE1 terrain_type PL1 number_of_tiles 0  base_size 24 circle_radius 30 0 left_border 5 right_border 4 top_border 6  bottom_border 5 other_zone_avoidance_distance 0 base_elevation 1 land_conformity 99 set_circular_base assign_to_player 1 zone 95 elseif ANGLE2 terrain_type PL2 number_of_tiles 0  base_size 24 circle_radius 30 0 left_border 5 right_border 4 top_border 6  bottom_border 5 other_zone_avoidance_distance 0 base_elevation 1 land_conformity 99 set_circular_base assign_to_player 1 zone 1 land_id 1  endif  }
    create_land { if ANGLE2A terrain_type PL1 number_of_tiles 0  base_size 24 circle_radius 30 0 left_border 5 right_border 4 top_border 6  bottom_border 5 other_zone_avoidance_distance 0 base_elevation 1 land_conformity 99 set_circular_base assign_to_player 2 zone 95 elseif ANGLE2B terrain_type PL2 number_of_tiles 0  base_size 24 circle_radius 30 0 left_border 5 right_border 4 top_border 6  bottom_border 5 other_zone_avoidance_distance 0 base_elevation 1 land_conformity 99 set_circular_base assign_to_player 2 zone 1 land_id 1 endif }
	create_land { if ANGLE2B terrain_type PL1 number_of_tiles 0  base_size 24 circle_radius 30 0 left_border 5 right_border 4 top_border 6  bottom_border 5 other_zone_avoidance_distance 0 base_elevation 1 land_conformity 99 set_circular_base assign_to_player 2 zone 95 elseif ANGLE2A terrain_type PL2 number_of_tiles 0  base_size 24 circle_radius 30 0 left_border 5 right_border 4 top_border 6  bottom_border 5 other_zone_avoidance_distance 0 base_elevation 1 land_conformity 99 set_circular_base assign_to_player 2 zone 1 land_id 1 endif }
	
