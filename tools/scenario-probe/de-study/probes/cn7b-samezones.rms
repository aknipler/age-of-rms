<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_player_lands { terrain_type DIRT base_size 3 number_of_tiles 0 }
create_land { terrain_type DESERT land_position 50 20 number_of_tiles 0 base_size 2 }
create_land { terrain_type DESERT land_position 50 80 number_of_tiles 0 base_size 2 }
create_land { terrain_type SNOW land_position 80 50 number_of_tiles 0 base_size 2 zone 1 }
<CONNECTION_GENERATION>
create_connect_same_land_zones { default_terrain_replacement ROAD terrain_size GRASS 0 0 terrain_size DIRT 0 0 terrain_size DESERT 0 0 terrain_size SNOW 0 0 }
