<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_player_lands { terrain_type DIRT base_size 3 number_of_tiles 0 }
create_land { terrain_type DESERT land_position 50 50 number_of_tiles 0 base_size 2 }
<CONNECTION_GENERATION>
create_connect_teams_lands { default_terrain_replacement ROAD terrain_size GRASS 0 0 terrain_size DIRT 0 0 terrain_size DESERT 0 0 terrain_size SNOW 0 0 }
create_connect_to_nonplayer_land { default_terrain_replacement ICE terrain_size GRASS 0 0 terrain_size DIRT 0 0 terrain_size DESERT 0 0 terrain_size SNOW 0 0 }
