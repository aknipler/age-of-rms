<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_player_lands { terrain_type DIRT base_size 4 number_of_tiles 200 }
create_land { terrain_type DESERT land_position 50 50 number_of_tiles 300 base_size 3 land_id 7 }
create_land { terrain_type DESERT land_position 20 80 number_of_tiles 300 base_size 3 land_id 7 }
<OBJECTS_GENERATION>
