create_object STONE { place_on_specific_land_id 7 avoid_other_land_zones 2 number_of_objects 5 }
create_object FORAGE { set_place_for_every_player set_gaia_object_only avoid_other_land_zones 1 number_of_objects 6 min_distance_to_players 5 }
