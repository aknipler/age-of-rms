<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain DESERT
create_land { terrain_type SNOW base_size 1 number_of_tiles 0 land_position 1 1 }
<TERRAIN_GENERATION>
create_terrain FOREST { base_terrain DESERT land_percent 15 number_of_clumps 10 }
create_terrain DIRT { base_terrain DESERT land_percent 10 number_of_clumps 10 clumping_factor -5 }
create_terrain SNOW { base_terrain DESERT spacing_to_other_terrain_types 1 spacing_to_specific_terrain FOREST 6 land_percent 30 number_of_clumps 30 }
