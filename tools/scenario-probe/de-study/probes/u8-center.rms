<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_player_lands { terrain_type DIRT base_size 5 number_of_tiles 150 }
<OBJECTS_GENERATION>
create_object TOWN_CENTER { set_place_for_every_player max_distance_to_players 0 }
create_object GOLD { set_place_for_every_player set_gaia_object_only find_closest_to_map_center number_of_objects 3 }
create_object STONE { set_place_for_every_player set_gaia_object_only find_closest_to_map_center number_of_groups 1 number_of_objects 4 set_loose_grouping }
create_object FORAGE { set_place_for_every_player set_gaia_object_only find_closest_to_map_center number_of_objects 5 set_tight_grouping }
