/* Land probe, shift K=0: K header blocks, then 5 neutral lands with random positions. */
<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_land { terrain_type WATER base_size 2 number_of_tiles 0 generate_mode 1 other_zone_avoidance_distance 0 }
create_land { terrain_type DESERT base_size 2 number_of_tiles 0 generate_mode 1 other_zone_avoidance_distance 0 }
create_land { terrain_type SNOW base_size 2 number_of_tiles 0 generate_mode 1 other_zone_avoidance_distance 0 }
create_land { terrain_type FOREST base_size 2 number_of_tiles 0 generate_mode 1 other_zone_avoidance_distance 0 }
create_land { terrain_type DIRT base_size 2 number_of_tiles 0 generate_mode 1 other_zone_avoidance_distance 0 }
