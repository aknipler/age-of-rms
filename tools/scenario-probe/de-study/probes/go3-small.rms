<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain DESERT
create_player_lands { terrain_type DIRT base_size 6 land_percent 20 }
create_land { terrain_type WATER land_position 50 50 number_of_tiles 500 base_size 4 }
<ELEVATION_GENERATION>
create_elevation 3 { base_terrain DESERT number_of_tiles 800 number_of_clumps 4 set_scale_by_size }
<CLIFF_GENERATION>
min_number_of_cliffs 4
max_number_of_cliffs 6
<TERRAIN_GENERATION>
create_terrain FOREST { base_terrain DESERT land_percent 8 number_of_clumps 8 set_avoid_player_start_areas }
