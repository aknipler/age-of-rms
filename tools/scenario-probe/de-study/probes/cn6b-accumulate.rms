<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_land { terrain_type DIRT land_position 15 50 number_of_tiles 0 base_size 1 zone 1 }
create_land { terrain_type DIRT land_position 85 50 number_of_tiles 0 base_size 1 zone 2 }
create_land { terrain_type DIRT land_position 50 15 number_of_tiles 0 base_size 1 zone 2 }
create_land { terrain_type DIRT land_position 50 85 number_of_tiles 0 base_size 1 zone 3 }
<CONNECTION_GENERATION>
accumulate_connections
create_connect_land_zones 1 2 { replace_terrain GRASS DESERT replace_terrain DESERT SNOW replace_terrain DIRT DESERT terrain_size GRASS 1 0 terrain_size DESERT 1 0 terrain_size DIRT 1 0 }
create_connect_land_zones 1 3 { replace_terrain DESERT ICE replace_terrain SNOW ICE replace_terrain GRASS LEAVES replace_terrain DIRT LEAVES terrain_cost DESERT 0.2 terrain_cost SNOW 0.2 terrain_size GRASS 0 0 terrain_size DIRT 0 0 terrain_size DESERT 0 0 terrain_size SNOW 0 0 }
