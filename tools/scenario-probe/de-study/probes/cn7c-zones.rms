<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_player_lands { terrain_type DIRT base_size 3 number_of_tiles 0 }
create_land { terrain_type SNOW land_position 50 15 number_of_tiles 0 base_size 2 zone 1 }
create_land { terrain_type DESERT land_position 20 50 number_of_tiles 0 base_size 2 }
create_land { terrain_type DESERT land_position 80 85 number_of_tiles 0 base_size 2 }
<CONNECTION_GENERATION>
create_connect_land_zones -9 1 { default_terrain_replacement ROAD terrain_size GRASS 0 0 terrain_size DIRT 0 0 terrain_size DESERT 0 0 terrain_size SNOW 0 0 }
create_connect_land_zones -10 -8 { default_terrain_replacement ICE terrain_size GRASS 0 0 terrain_size DIRT 0 0 terrain_size DESERT 0 0 terrain_size SNOW 0 0 }
