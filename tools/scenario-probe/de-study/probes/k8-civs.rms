<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_player_lands { terrain_type DIRT base_size 5 number_of_tiles 100 }
<OBJECTS_GENERATION>
create_object TOWN_CENTER { set_place_for_every_player max_distance_to_players 0 }
create_object VILLAGER { set_place_for_every_player min_distance_to_players 6 max_distance_to_players 6 }
create_object SCOUT { set_place_for_every_player min_distance_to_players 7 max_distance_to_players 9 }
create_object DEER { set_place_for_every_player set_gaia_object_only number_of_objects 3 min_distance_to_players 12 max_distance_to_players 16 }
