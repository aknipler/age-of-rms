<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_land { terrain_type SNOW land_position 80 20 number_of_tiles 0 base_size 1 }
<TERRAIN_GENERATION>
create_terrain DIRT { base_terrain GRASS number_of_tiles 900 number_of_clumps 25 }
<OBJECTS_GENERATION>
create_object GOLD { number_of_groups 6 number_of_objects 3 group_placement_radius 1 min_distance_group_placement 6 second_object STONE }
create_object FORAGE { number_of_objects 8 set_facet 2 }
create_object DEER { number_of_groups 5 number_of_objects 3 terrain_to_place_on DIRT min_connected_tiles 30 }
create_object SHEEP { number_of_objects 15 force_placement terrain_to_place_on SNOW }
