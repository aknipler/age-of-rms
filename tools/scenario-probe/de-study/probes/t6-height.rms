<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain DESERT
create_land { terrain_type SNOW base_size 1 number_of_tiles 0 land_position 1 1 }
<ELEVATION_GENERATION>
create_elevation 3 { base_terrain DESERT number_of_tiles 1500 number_of_clumps 4 }
<TERRAIN_GENERATION>
create_terrain DIRT { base_terrain DESERT land_percent 100 number_of_clumps 200 height_limits 1 2 }
create_terrain SNOW { base_terrain DESERT land_percent 100 number_of_clumps 200 spacing_to_other_terrain_types 1 set_flat_terrain_only }
