<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_land { terrain_type DESERT land_position 50 50 number_of_tiles 0 base_size 2 }
create_player_lands { terrain_type DIRT base_size 3 number_of_tiles 0 }
create_land { terrain_type SNOW land_position 85 15 number_of_tiles 0 base_size 2 zone 1 }
<CONNECTION_GENERATION>
create_connect_to_nonplayer_land { default_terrain_replacement ROAD terrain_size GRASS 0 0 terrain_size DIRT 0 0 terrain_size DESERT 0 0 terrain_size SNOW 0 0 }
create_connect_all_players_land { default_terrain_replacement ICE terrain_size GRASS 0 0 terrain_size DIRT 0 0 terrain_size DESERT 0 0 terrain_size SNOW 0 0 }
create_connect_all_lands { default_terrain_replacement LEAVES terrain_size GRASS 0 0 terrain_size DIRT 0 0 terrain_size DESERT 0 0 terrain_size SNOW 0 0 }
create_connect_land_zones 1 -10 { default_terrain_replacement DLC_ROCK terrain_size GRASS 0 0 terrain_size DIRT 0 0 terrain_size DESERT 0 0 terrain_size SNOW 0 0 }
