<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_player_lands { terrain_type DIRT base_size 5 number_of_tiles 150 }
<OBJECTS_GENERATION>
create_actor_area 25 25 1 6
create_actor_area 95 95 2 12
create_object TOWN_CENTER { set_place_for_every_player max_distance_to_players 0 actor_area 5 actor_area_radius 14 }
create_object GOLD { number_of_objects 8 actor_area_to_place_in 1 }
create_object STONE { number_of_objects 30 avoid_actor_area 2 }
create_object FORAGE { number_of_objects 30 avoid_actor_area 5 }
create_object HOUSE { set_place_for_every_player number_of_objects 3 actor_area_to_place_in 5 override_actor_radius_if_required }
create_object SHEEP { set_place_for_every_player number_of_objects 2 min_distance_to_players 8 max_distance_to_players 10 actor_area 6 }
create_object BOAR { number_of_objects 20 avoid_actor_area 6 }
create_object DEER { number_of_objects 30 avoid_all_actor_areas }
