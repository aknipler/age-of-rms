<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain DESERT
create_land { terrain_type DIRT land_position 15 15 number_of_tiles 0 base_size 1 }
create_land { terrain_type DIRT land_position 85 85 number_of_tiles 0 base_size 1 }
<TERRAIN_GENERATION>
create_terrain WATER { base_terrain DESERT number_of_tiles 1500 number_of_clumps 6 spacing_to_other_terrain_types 1 }
create_terrain GRASS { base_terrain DESERT land_percent 100 number_of_clumps 300 beach_terrain DLC_BEACH2 }
<CONNECTION_GENERATION>
create_connect_all_lands { replace_terrain DIRT ROAD terrain_size GRASS 0 0 terrain_size DIRT 0 0 terrain_size DESERT 0 0 terrain_size SNOW 0 0 }
