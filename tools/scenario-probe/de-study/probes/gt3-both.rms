<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_land { terrain_type SNOW base_size 1 number_of_tiles 0 land_position 1 1 }
<TERRAIN_GENERATION>
create_terrain DESERT { base_terrain GRASS terrain_mask 1 land_percent 20 number_of_clumps 5 }
create_terrain LEAVES { base_terrain GRASS base_layer DESERT terrain_mask 1 number_of_tiles 300 }
create_terrain SNOW { base_terrain GRASS base_layer DESERT land_percent 100 number_of_clumps 400 }
