<CONNECTION_GENERATION>
accumulate_connections

create_connect_all_players_land {
	replace_terrain DLC_BLACK ROCK_WET
	replace_terrain ROAD_GRAVEL DLC_ROCK
	terrain_cost DLC_BLACK 3
	terrain_cost ROAD_GRAVEL 3
	
	terrain_size ROAD_GRAVEL 5 0
	terrain_size DLC_BLACK 5 0
	terrain_size ROCK_WET 0 0
	terrain_size DLC_ROCK 0 0
	terrain_size GRAVEL_WET 0 0
	terrain_size GRAVEL_GREY 0 0
	terrain_size MUD 0 0
	terrain_size DLC_JUNGLEGRASSK 0 0
	terrain_size GRASS_RAINFOREST 0 0
	terrain_size GRASS2 0 0
	terrain_size DLC_RAINFOREST 0 0
	terrain_size PASTURE_DEAD 0 0
}

create_connect_land_zones 11 12 {
	replace_terrain ROAD_GRAVEL DLC_BOGLAND
	replace_terrain DLC_ROCK DLC_BOGLAND
	replace_terrain DLC_BLACK DLC_BOGLAND

	terrain_cost GRAVEL_WET 0
	terrain_cost GRAVEL_GREY 0
	terrain_cost MUD 0
	terrain_cost DLC_RAINFOREST 0
	
	terrain_cost DLC_BLACK 2
	terrain_cost ROCK_WET 2
	terrain_cost ROAD_GRAVEL 1
	terrain_cost DLC_ROCK 1
}

create_connect_land_zones 13 14 {
	replace_terrain ROAD_GRAVEL DLC_BOGLAND
	replace_terrain DLC_ROCK DLC_BOGLAND
	replace_terrain DLC_BLACK DLC_BOGLAND

	terrain_cost GRAVEL_WET 0
	terrain_cost GRAVEL_GREY 0
	terrain_cost MUD 0
	terrain_cost DLC_RAINFOREST 0
	
	terrain_cost DLC_BLACK 2
	terrain_cost ROCK_WET 2
	terrain_cost ROAD_GRAVEL 1
	terrain_cost DLC_ROCK 1
}
	
create_connect_all_lands {
	replace_terrain ROCK_WET DLC_ROCK
	terrain_size DLC_RAINFOREST 420 0
}

