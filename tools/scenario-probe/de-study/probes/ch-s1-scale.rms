<PLAYER_SETUP>
random_placement
override_map_size 200
<LAND_GENERATION>
base_terrain DESERT
<OBJECTS_GENERATION>
create_object GOLD { set_gaia_object_only number_of_groups 3 set_scale_by_groups }
