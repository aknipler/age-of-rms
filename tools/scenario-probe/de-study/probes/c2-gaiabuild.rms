<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_player_lands { terrain_type DIRT base_size 6 number_of_tiles 200 }
<OBJECTS_GENERATION>
create_object TOWN_CENTER { set_place_for_every_player max_distance_to_players 0 }
create_object BARRACKS { set_gaia_object_only number_of_objects 3 min_distance_to_players 15 }
create_object MARKET { set_gaia_object_only number_of_objects 2 min_distance_to_players 15 }
create_object MONASTERY { set_gaia_object_only number_of_objects 2 min_distance_to_players 15 }
create_object MILL { set_gaia_object_only number_of_objects 3 min_distance_to_players 15 }
create_object CASTLE { set_gaia_object_only number_of_objects 1 min_distance_to_players 20 }
create_object BARRACKS { set_place_for_every_player min_distance_to_players 6 max_distance_to_players 9 }
create_object MILL { set_place_for_every_player min_distance_to_players 6 max_distance_to_players 9 }
