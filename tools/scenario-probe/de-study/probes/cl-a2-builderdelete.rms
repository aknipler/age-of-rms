#const PH_N 346
#const PH_P 647
<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_player_lands { terrain_type DIRT number_of_tiles 0 base_size 10 }
<OBJECTS_GENERATION>
create_object TOWN_CENTER { set_place_for_every_player max_distance_to_players 0 }
create_object PH_N { set_place_for_every_player set_gaia_object_only number_of_objects 8 min_distance_to_players 1 max_distance_to_players 1 find_closest }
create_object PH_P { set_place_for_every_player number_of_objects 3 min_distance_to_players 1 max_distance_to_players 1 find_closest }
create_object PH_N { set_place_for_every_player set_gaia_object_only number_of_objects 5 min_distance_to_players 3 max_distance_to_players 3 find_closest }
create_object SHEEP { set_place_for_every_player number_of_objects 4 min_distance_to_players 3 max_distance_to_players 3 find_closest }
create_object DEER { number_of_objects 3 number_of_groups 6 set_loose_grouping set_gaia_object_only min_distance_to_players 15 }
create_object GOLD { number_of_objects 3 number_of_groups 4 set_tight_grouping set_gaia_object_only min_distance_to_players 15 temp_min_distance_group_placement 10 }
create_object FORAGE { number_of_objects 1 number_of_groups 20 set_gaia_object_only min_distance_to_players 12 }
