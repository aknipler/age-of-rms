<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_player_lands { terrain_type DIRT land_percent 40 base_size 10 border_fuzziness 5 clumping_factor 15 other_zone_avoidance_distance 7 }
create_land { terrain_type WATER land_percent 5 land_position 50 50 base_size 6 }
