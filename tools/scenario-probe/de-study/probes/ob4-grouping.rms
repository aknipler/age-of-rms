<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_land { terrain_type SNOW land_position 1 1 number_of_tiles 0 base_size 1 }
<TERRAIN_GENERATION>
create_terrain DIRT { base_terrain GRASS number_of_tiles 1200 number_of_clumps 40 }
<OBJECTS_GENERATION>
create_object GOLD { number_of_groups 3 number_of_objects 6 group_placement_radius 3 set_tight_grouping terrain_to_place_on DIRT }
create_object STONE { number_of_groups 3 number_of_objects 6 group_placement_radius 3 set_loose_grouping terrain_to_place_on DIRT }
create_object FORAGE { number_of_groups 3 number_of_objects 6 group_placement_radius 3 terrain_to_place_on DIRT }
create_object DEER { number_of_groups 4 number_of_objects 5 group_variance 3 }
