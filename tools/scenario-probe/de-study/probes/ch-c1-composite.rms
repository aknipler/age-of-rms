#const T_C34 34
#const T_C62 62
<PLAYER_SETUP>
random_placement
<LAND_GENERATION>
base_terrain GRASS
create_land { terrain_type T_C34 land_position 20 20 number_of_tiles 0 base_size 8 }
create_land { terrain_type T_C62 land_position 50 20 number_of_tiles 0 base_size 8 }
create_land { terrain_type DESERT land_position 80 20 number_of_tiles 0 base_size 8 }
<TERRAIN_GENERATION>
create_terrain T_C62 { base_terrain DESERT land_percent 100 number_of_clumps 1 }
<OBJECTS_GENERATION>
create_object GOLD { set_gaia_object_only number_of_groups 20 terrain_to_place_on GRASS }
create_object DEER { set_gaia_object_only number_of_groups 20 terrain_to_place_on GRASS }
