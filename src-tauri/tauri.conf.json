{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Age of RMS",
  "version": "../package.json",
  "identifier": "com.aorms.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Age of RMS",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 Ash Knipler. Licensed under GPL-3.0.",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "longDescription": "A community built, open-source program to lower the barrier of entry for newcomers (via a block-based breakdown view) and centralise RMS tools for experienced creators alongside a full code editor with advanced debugging.",
    "shortDescription": "RMS editor for Age of Empires II: DE",
    "publisher": "Ash Knipler",
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2QjlDQkRCQjM1NUY1NDkKUldSSjlWV3oyOHU1RmxwV25JdFZzeHJ1cnRiMHQxWnh0MDBOVEoxL0Q1NHFEMTR5TnB1NmpzOUoK",
      "endpoints": ["https://github.com/aknipler/age-of-rms/releases/latest/download/latest.json"]
    }
  }
}
